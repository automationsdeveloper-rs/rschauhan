# ── Client-side (bundled into the browser: never put secrets here) ──────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SITE_NAME=HireNest
VITE_TURNSTILE_SITE_KEY=          # optional: Cloudflare Turnstile widget site key
VITE_GA_ID=                       # optional: Google Analytics 4 measurement id (G-XXXXXXX), loads only after cookie consent

# ── Build + server (Vercel) ─────────────────────────────────────────────────────
SITE_URL=https://yourdomain.com   # absolute URL: robots.txt, sitemap, Open Graph tags, email links
SUPABASE_SERVICE_ROLE_KEY=        # server only. Bypasses RLS — never expose to the browser
RESEND_API_KEY=
EMAIL_FROM="HireNest <no-reply@yourdomain.com>"
ADMIN_NOTIFY_EMAIL=               # gets a mail for every application, paid request and contact message
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=             # optional: pairs with VITE_TURNSTILE_SITE_KEY
CRON_SECRET=                      # any long random string; protects /api/cleanup-uploads (Vercel cron)
